// Resource caps for the smoke fixture. The synthetic data fits in <1 GB RAM
// per process; the defaults in conf/base.config (12 CPUs / 48 GB for the
// process_high label) would not fit on a GitHub-hosted runner.

process {
    cpus   = 2
    memory = 4.GB

    withLabel: process_low    { cpus = 1; memory = 2.GB }
    withLabel: process_medium { cpus = 2; memory = 4.GB }
    withLabel: process_high   { cpus = 2; memory = 4.GB }
}
