// Plant Genome Portal — transcriptome pipeline
//
// Inputs:
//   --input              CSV samplesheet (sample,sra,fastq_1,fastq_2,strandedness)
//   --genome_fasta       Reference genome FASTA (.fa[.gz])
//   --gtf                Gene annotation GTF (.gtf[.gz])
//   --transcripts_fasta  Transcripts FASTA for Salmon (.fa[.gz])
//   --salmon_index       Optional prebuilt Salmon index dir (skip SALMON_INDEX)
//   --hisat2_index       Optional prebuilt HISAT2 index dir (skip HISAT2_BUILD)
//   --outdir             Output directory (default: results)

manifest {
    name            = 'plant-genome-portal/transcriptome'
    author          = 'plant-genome-portal'
    description     = 'RNA-seq quantification pipeline (fastp + Salmon + HISAT2 + Qualimap + MultiQC)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    input              = null
    outdir             = 'results'

    genome_fasta       = null
    gtf                = null
    transcripts_fasta  = null
    salmon_index       = null
    hisat2_index       = null

    multiqc_config     = "${projectDir}/assets/multiqc_config.yml"
    skip_multiqc       = false

    publish_dir_mode   = 'copy'
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        podman.enabled         = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
