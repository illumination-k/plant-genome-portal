// Minimal test profile. Run with:
//   nextflow run pipelines/transcriptome -profile docker,test
//
// Override these paths with your own fixture before running.

params {
    input             = "${projectDir}/samplesheets/samplesheet.example.csv"
    genome_fasta      = null
    gtf               = null
    transcripts_fasta = null
}

process {
    cpus   = 2
    memory = 6.GB
}
