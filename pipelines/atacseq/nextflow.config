// Plant Genome Portal — ATAC-seq pipeline
//
// Inputs:
//   --input              CSV samplesheet (sample,group,replicate,sra,fastq_1,fastq_2)
//   --genome_fasta       Reference genome FASTA (.fa[.gz])
//   --bowtie2_index      Optional prebuilt Bowtie2 index dir (basename `genome`)
//   --macs_gsize         Effective genome size for MACS3 (required, e.g. 2.25e8 for Marchantia)
//   --mito_names         Comma-separated mitochondrial / plastid sequence names to drop
//                        (default: 'chrM,Mt,MT,Pt,chrPt,chrMt,Mp_MT,Mp_PT')
//   --skip_peaks         Skip peak calling (alignment + QC only)
//   --skip_motifs        Skip HOMER motif analysis
//   --skip_bigwig        Skip deepTools bigWig generation
//   --skip_frip          Skip FRiP calculation
//   --skip_multiqc       Skip MultiQC aggregation
//   --outdir             Output directory (default: results)

manifest {
    name            = 'plant-genome-portal/atacseq'
    author          = 'plant-genome-portal'
    description     = 'ATAC-seq pipeline (fastp + Bowtie2 + Picard + Tn5 shift + MACS3 + HOMER + deepTools + MultiQC)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    input            = null
    outdir           = 'results'

    genome_fasta     = null
    bowtie2_index    = null

    // Mitochondrial / plastid contigs to drop before peak calling.
    // Plant ATAC libraries are usually dominated by organelle reads, so this
    // is the single most impactful QC step.
    mito_names       = 'chrM,Mt,MT,Pt,chrPt,chrMt,Mp_MT,Mp_PT'

    // Peak calling — ATAC-specific MACS3 defaults
    macs_gsize       = null          // required (e.g. 2.25e8 for Marchantia)
    macs_qvalue      = 0.05
    macs_broad       = false         // ATAC is usually narrow; flip for chromatin domains
    macs_shift       = -75           // for SE only; PE uses BAMPE and ignores shift/extsize
    macs_extsize     = 150           // for SE only

    // Motif analysis (HOMER findMotifsGenome.pl)
    homer_size       = 200
    homer_mset       = null          // 'plants' / 'vertebrates' / ... (auto if null)
    homer_extra_args = '-mask'

    // Alignment & filtering
    bowtie2_maxins   = 2000          // -X for Bowtie2 PE (ATAC fragments up to ~2 kb)
    min_mapq         = 30
    keep_dups        = false         // drop duplicates after MarkDuplicates
    atac_shift       = true          // apply Tn5 +4/-5 shift via deepTools alignmentSieve

    // BigWig
    bigwig_binsize   = 50
    bigwig_normalize = 'CPM'         // CPM | RPGC | BPM | RPKM | None

    // Switches
    skip_peaks       = false
    skip_motifs      = false
    skip_bigwig      = false
    skip_frip        = false
    skip_multiqc     = false

    multiqc_config   = "${projectDir}/assets/multiqc_config.yml"
    publish_dir_mode = 'copy'
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        podman.enabled         = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
