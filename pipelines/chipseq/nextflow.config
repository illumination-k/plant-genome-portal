// Plant Genome Portal — ChIP-seq / CUT&RUN pipeline
//
// Inputs:
//   --input              CSV samplesheet (sample,group,replicate,control,assay,sra,fastq_1,fastq_2)
//   --genome_fasta       Reference genome FASTA (.fa[.gz])
//   --bowtie2_index      Optional prebuilt Bowtie2 index dir (basename `genome`)
//   --macs_gsize         Effective genome size for MACS2 (required for chipseq, e.g. 2.25e8 for Marchantia)
//   --skip_peaks         Skip peak calling (alignment + QC only)
//   --skip_bigwig        Skip deepTools bigWig generation
//   --skip_multiqc       Skip MultiQC aggregation
//   --outdir             Output directory (default: results)

manifest {
    name            = 'plant-genome-portal/chipseq'
    author          = 'plant-genome-portal'
    description     = 'ChIP-seq / CUT&RUN pipeline (fastp + Bowtie2 + Picard + MACS2/SEACR + deepTools + MultiQC)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    input            = null
    outdir           = 'results'

    genome_fasta     = null
    bowtie2_index    = null

    // Peak calling
    macs_gsize       = null     // required for MACS2 (chipseq), e.g. 2.25e8 for Marchantia
    macs_broad       = false    // call MACS2 in broad mode
    macs_qvalue      = 0.05
    seacr_threshold  = 0.01     // SEACR non-control threshold mode
    seacr_stringency = 'stringent' // 'stringent' | 'relaxed'

    // Filtering
    min_mapq         = 30
    keep_dups        = false    // keep duplicates after MarkDuplicates

    // BigWig
    bigwig_binsize   = 50
    bigwig_normalize = 'CPM'    // CPM | RPGC | BPM | RPKM | None

    // Switches
    skip_peaks       = false
    skip_bigwig      = false
    skip_multiqc     = false

    multiqc_config   = "${projectDir}/assets/multiqc_config.yml"
    publish_dir_mode = 'copy'
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        podman.enabled         = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
